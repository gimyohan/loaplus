DATABASE_URL="postgresql://user:password@localhost:5432/loaplus?schema=public"
PORT=4000

# 세션 쿠키를 실어 호출 가능한 프론트 origin, 콤마로 여러 개 나열 가능.
# 비워두면 로컬 dev 서버(http://localhost:5173) 하나만 허용. 배포 환경에서는 실제 도메인으로
# 덮어쓴다 (예: CORS_ORIGINS="https://javago.my").
CORS_ORIGINS="http://localhost:5173"

# Google OAuth (docs/api.typ - 인증 및 유저)
GOOGLE_CLIENT_ID=""

# 자체 세션 쿠키 서명용 (docs/api.typ - 보안 유의사항)
SESSION_SECRET=""

# Users.lostark_api_key 를 저장 전 암호화하는 데 쓰는 키 (docs/db_schema.typ)
LOSTARK_KEY_ENCRYPTION_SECRET=""
